# Copie para .env e ajuste. O compose tem valores padrão de desenvolvimento para tudo, então o .env é opcional.
APP_ENV=dev
DB_NAME=goomer
DB_USER=goomer
DB_PASSWORD=goomer
# Pelo menos 32 caracteres; gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
APP_RESET_URL=http://localhost:8091/reset-password
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM="Goomer Menu <no-reply@goomer.local>"
# Grupo dono do /var/run/docker.sock (stat -c %g /var/run/docker.sock), para o Testcontainers no serviço test
DOCKER_GID=999
